// apps/web/tsconfig.json
{
  "extends": "../../tsconfig.base.json", // ✅ 继承根目录基础配置
  "compilerOptions": {
    "lib": ["ES2020", "DOM", "DOM.Iterable"], // ✅ Web 环境必须加 DOM
    "jsx": "react-jsx", // ✅ React 项目必须开启 JSX 支持
    "types": ["vite/client"], // ✅ 让 TS 识别 import.meta.env 等 Vite 特有语法
    "outDir": "./dist",
    "noEmit": true 
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "src/**/*.js",  "src/**/*.d.ts"]
}